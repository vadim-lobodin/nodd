{
  "name": "@vadim_lobodin/nodd",
  "version": "0.4.2",
  "description": "Figma-like spatial comments and state variants for live React prototypes",
  "keywords": [
    "react",
    "comments",
    "annotations",
    "feedback",
    "variants",
    "figma",
    "prototype",
    "supabase",
    "overlay"
  ],
  "author": "Vadim Lobodin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vadim-lobodin/nodd.git"
  },
  "homepage": "https://github.com/vadim-lobodin/nodd#readme",
  "bugs": {
    "url": "https://github.com/vadim-lobodin/nodd/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "bin": {
    "nodd": "bin/nodd.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "bin",
    "supabase/migrations",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@carbon/icons-react": "11.82.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "1.2.4",
    "@supabase/supabase-js": "2.107.0",
    "boring-avatars": "2.0.4",
    "idb-keyval": "6.2.5"
  },
  "devDependencies": {
    "@storybook/react": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@types/react": "18.3.30",
    "@types/react-dom": "^18",
    "react": "^18",
    "react-dom": "^18",
    "storybook": "10.4.2",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "8.0.16"
  }
}
